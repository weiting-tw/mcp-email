{
  "mcpServers": {
    "email": {
      "command": "uvx",
      "args": ["mcp-email"],
      "env": {
        "IMAP_SERVER": "imap.gmail.com",
        "IMAP_PORT": "993",
        "SMTP_SERVER": "smtp.gmail.com",
        "SMTP_PORT": "465",
        "SMTP_USE_SSL": "true",
        "EMAIL_USER": "you@gmail.com",
        "EMAIL_PASS": "REPLACE_WITH_APP_PASSWORD"
      }
    }
  }
}
